<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Task 3.7: standard scrap reasons; stock counts use the standard "Inventory Reason" on apply. -->
    <record id="scrap_reason_damaged_transit" model="stock.scrap.reason.tag">
        <field name="name">Damaged in Transit</field>
        <field name="sequence">10</field>
    </record>
    <record id="scrap_reason_damaged_warehouse" model="stock.scrap.reason.tag">
        <field name="name">Damaged in Warehouse</field>
        <field name="sequence">20</field>
    </record>
    <record id="scrap_reason_expired" model="stock.scrap.reason.tag">
        <field name="name">Expired</field>
        <field name="sequence">30</field>
    </record>
    <record id="scrap_reason_customer_return" model="stock.scrap.reason.tag">
        <field name="name">Customer Return - Not Resaleable</field>
        <field name="sequence">40</field>
    </record>
    <record id="scrap_reason_sample" model="stock.scrap.reason.tag">
        <field name="name">Sample / Marketing</field>
        <field name="sequence">50</field>
    </record>
</odoo>
