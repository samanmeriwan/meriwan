<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Task 13.1 / sheet 'Order Form - Fields' section D. Each role implies the
         standard Odoo groups it needs, so the standard apps keep their own rights. -->
    <record id="res_groups_privilege_mariwan" model="res.groups.privilege">
        <field name="name">Mariwan Order Form</field>
        <field name="sequence">5</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <record id="group_cost_access" model="res.groups">
        <field name="name">Mariwan: Cost and Margin Access</field>
        <field name="comment">Shows vendor cost, landed cost, total cost and margin on the Order Form.</field>
    </record>

    <record id="group_warehouse" model="res.groups">
        <field name="name">Warehouse</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_mariwan"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>
    <record id="group_officer" model="res.groups">
        <field name="name">Sales / Purchase Officer</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_mariwan"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman')),
                                         (4, ref('purchase.group_purchase_user')),
                                         (4, ref('stock.group_stock_user'))]"/>
    </record>
    <record id="group_accountant" model="res.groups">
        <field name="name">Accountant</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_mariwan"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_user')),
                                         (4, ref('sales_team.group_sale_salesman_all_leads')),
                                         (4, ref('stock.group_stock_user')),
                                         (4, ref('group_cost_access'))]"/>
    </record>
    <record id="group_pricing_manager" model="res.groups">
        <field name="name">Pricing Manager</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="res_groups_privilege_mariwan"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_manager')),
                                         (4, ref('stock.group_stock_user')),
                                         (4, ref('group_cost_access'))]"/>
    </record>
    <record id="group_finance_manager" model="res.groups">
        <field name="name">Finance Manager</field>
        <field name="sequence">50</field>
        <field name="privilege_id" ref="res_groups_privilege_mariwan"/>
        <field name="implied_ids" eval="[(4, ref('group_accountant')),
                                         (4, ref('account.group_account_manager'))]"/>
    </record>
    <record id="group_sales_manager" model="res.groups">
        <field name="name">Sales Manager / Management</field>
        <field name="sequence">60</field>
        <field name="privilege_id" ref="res_groups_privilege_mariwan"/>
        <field name="implied_ids" eval="[(4, ref('group_officer')),
                                         (4, ref('group_cost_access')),
                                         (4, ref('sales_team.group_sale_manager')),
                                         (4, ref('purchase.group_purchase_manager'))]"/>
    </record>
    <record id="group_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">70</field>
        <field name="privilege_id" ref="res_groups_privilege_mariwan"/>
        <field name="implied_ids" eval="[(4, ref('group_sales_manager')),
                                         (4, ref('group_finance_manager')),
                                         (4, ref('group_pricing_manager')),
                                         (4, ref('stock.group_stock_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</odoo>
