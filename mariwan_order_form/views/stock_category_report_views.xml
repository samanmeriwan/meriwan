<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mariwan_stock_category_report_list" model="ir.ui.view">
        <field name="name">mariwan.stock.category.report.list</field>
        <field name="model">mariwan.stock.category.report</field>
        <field name="arch" type="xml">
            <list string="Stock by Category" create="0" edit="0" delete="0">
                <field name="categ_id"/>
                <field name="product_id"/>
                <field name="uom_id" optional="hide" options="{'no_open': True}"/>
                <field name="on_hand_qty" sum="Total"/>
                <field name="delivery_reserved_qty" sum="Total" optional="hide"/>
                <field name="hold_qty" sum="Total" optional="hide"/>
                <field name="reserved_qty" sum="Total"/>
                <field name="free_qty" sum="Total"/>
                <field name="sale_price" optional="show"/>
                <field name="sale_value" sum="Total"/>
                <field name="stock_value" sum="Total" groups="mariwan_order_form.group_cost_access"/>
            </list>
        </field>
    </record>

    <record id="view_mariwan_stock_category_report_pivot" model="ir.ui.view">
        <field name="name">mariwan.stock.category.report.pivot</field>
        <field name="model">mariwan.stock.category.report</field>
        <field name="arch" type="xml">
            <pivot string="Stock by Category">
                <field name="categ_id" type="row"/>
                <field name="on_hand_qty" type="measure"/>
                <field name="reserved_qty" type="measure"/>
                <field name="free_qty" type="measure"/>
                <field name="sale_value" type="measure"/>
                <field name="stock_value" type="measure" groups="mariwan_order_form.group_cost_access"/>
            </pivot>
        </field>
    </record>

    <record id="view_mariwan_stock_category_report_search" model="ir.ui.view">
        <field name="name">mariwan.stock.category.report.search</field>
        <field name="model">mariwan.stock.category.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="categ_id"/>
                <filter name="in_stock" string="In Stock" domain="[('on_hand_qty', '>', 0)]"/>
                <filter name="reserved" string="Has Reservations" domain="[('reserved_qty', '>', 0)]"/>
                <filter name="no_free" string="No Free Stock" domain="[('free_qty', '&lt;=', 0)]"/>
                <group>
                    <filter name="group_categ" string="Product Category" context="{'group_by': 'categ_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mariwan_stock_category_report" model="ir.actions.act_window">
        <field name="name">Stock by Category</field>
        <field name="res_model">mariwan.stock.category.report</field>
        <field name="view_mode">list,pivot</field>
        <field name="context">{'search_default_group_categ': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No stocked products yet</p>
        </field>
    </record>
</odoo>
