<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tasks 5.11, 10.1, 2.7 -->
    <record id="view_order_form_mariwan" model="ir.ui.view">
        <field name="name">sale.order.form.mariwan</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_mariwan_override_credit" string="Override Credit Block" type="object"
                        groups="mariwan_order_form.group_finance_manager"
                        invisible="state not in ('draft', 'sent') or mariwan_payment_type != 'credit' or mariwan_credit_override"
                        confirm="Allow this order to be confirmed despite the credit limit / overdue check?"/>
            </xpath>
            <!-- Payments of the invoices; the standard button counts online payments only -->
            <xpath expr="//button[@name='action_view_payment_transaction']" position="attributes">
                <attribute name="invisible">transaction_count == 0</attribute>
                <attribute name="string">Online Payments</attribute>
            </xpath>
            <xpath expr="//button[@name='action_view_payment_transaction']" position="before">
                <button name="action_mariwan_view_payments" type="object" class="oe_stat_button" icon="payments"
                        groups="account.group_account_invoice,account.group_account_readonly"
                        invisible="state != 'sale'">
                    <field name="mariwan_payment_count" widget="statinfo" string="Payments"/>
                </button>
            </xpath>
            <xpath expr="//group[@name='order_details']" position="inside">
                <field name="mariwan_order_form_id" invisible="not mariwan_order_form_id"/>
                <field name="mariwan_payment_type"/>
                <field name="mariwan_payment_status" widget="badge" invisible="state != 'sale'"
                       decoration-success="mariwan_payment_status == 'paid'"
                       decoration-warning="mariwan_payment_status == 'partial'"
                       decoration-danger="mariwan_payment_status == 'not_paid'"/>
                <field name="mariwan_amount_paid" invisible="state != 'sale'"/>
                <field name="mariwan_delivery_released" invisible="mariwan_payment_type != 'cash'"/>
                <field name="mariwan_credit_override" invisible="not mariwan_credit_override"/>
            </xpath>
            <xpath expr="(//field[@name='order_line']//list//field[@name='product_uom_qty'])[1]" position="after">
                <field name="mariwan_delivery_date" optional="show"/>
                <field name="mariwan_reservation_status" optional="show"/>
            </xpath>
        </field>
    </record>
    <record id="view_order_tree_mariwan" model="ir.ui.view">
        <field name="name">sale.order.list.mariwan</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <field name="invoice_status" position="after">
                <field name="mariwan_payment_status" widget="badge" optional="show"
                       decoration-success="mariwan_payment_status == 'paid'"
                       decoration-warning="mariwan_payment_status == 'partial'"
                       decoration-danger="mariwan_payment_status == 'not_paid'"/>
            </field>
        </field>
    </record>
</odoo>
