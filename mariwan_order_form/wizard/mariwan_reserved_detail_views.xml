<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mariwan_reserved_detail_form" model="ir.ui.view">
        <field name="name">mariwan.reserved.detail.form</field>
        <field name="model">mariwan.reserved.detail</field>
        <field name="arch" type="xml">
            <form string="Reserved Stock">
                <group>
                    <group>
                        <field name="product_id" readonly="1"/>
                        <field name="warehouse_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="mode" string="Showing" readonly="1"/>
                        <label for="total_qty"/>
                        <div class="o_row">
                            <field name="total_qty" readonly="1"/>
                            <field name="product_uom_id" readonly="1" options="{'no_open': True}"/>
                        </div>
                    </group>
                </group>
                <field name="detail_ids" readonly="1">
                    <list>
                        <field name="partner_id"/>
                        <field name="quantity" sum="Total"/>
                        <field name="product_uom_id" options="{'no_open': True}"/>
                        <field name="delivery_date"/>
                        <field name="source" widget="badge" decoration-info="source == 'hold'"
                               decoration-success="source == 'delivery'" decoration-warning="source == 'internal'"/>
                        <field name="reference"/>
                        <field name="order_form_id"/>
                        <field name="sale_order"/>
                        <field name="reserved_on" optional="show"/>
                        <field name="user_id" widget="many2one_avatar_user" optional="hide"/>
                    </list>
                </field>
                <footer>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
