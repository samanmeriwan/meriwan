<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Task 12.2: Order Form print -->
    <template id="report_order_form_document">
        <t t-call="web.external_layout">
            <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
            <t t-set="address">
                <div t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True}'/>
            </t>
            <div class="page">
                <h2>Order Form <span t-field="o.name"/></h2>
                <div class="row mb-4" id="informations">
                    <div class="col"><strong>Date</strong><div t-field="o.date"/></div>
                    <div class="col" t-if="o.contact_name"><strong>Contact</strong>
                        <div><span t-field="o.contact_name"/> <span t-field="o.contact_phone"/></div></div>
                    <div class="col"><strong>Salesperson</strong><div t-field="o.user_id"/></div>
                    <div class="col"><strong>Order Type</strong><div t-field="o.order_type"/></div>
                    <div class="col"><strong>Payment</strong><div><span t-field="o.payment_type"/>
                        <t t-if="o.payment_type == 'credit'"> - <span t-field="o.payment_term_id"/></t></div></div>
                    <div class="col" t-if="o.delivery_date"><strong>Tentative Delivery</strong><div t-field="o.delivery_date"/></div>
                    <div class="col" t-if="o.client_order_ref"><strong>Your Reference</strong><div t-field="o.client_order_ref"/></div>
                </div>
                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th class="text-start">SKU</th>
                            <th class="text-start">Description</th>
                            <th class="text-end">Requested</th>
                            <th class="text-end">Available</th>
                            <th class="text-end">Reserved</th>
                            <th class="text-start">Availability</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.line_ids" t-as="line">
                            <td><span t-field="line.product_id.default_code"/></td>
                            <td><span t-field="line.name"/></td>
                            <td class="text-end"><span t-field="line.product_qty"/> <span t-field="line.product_uom_id" groups="uom.group_uom"/></td>
                            <td class="text-end"><span t-out="min(line.free_qty, line.product_qty)" t-options='{"widget": "float", "precision": 2}'/></td>
                            <td class="text-end"><span t-field="line.reserved_qty"/></td>
                            <td><span t-field="line.availability_status"/></td>
                            <td class="text-end"><span t-field="line.price_unit"/></td>
                            <td class="text-end"><span t-field="line.price_subtotal"/></td>
                        </tr>
                    </tbody>
                </table>
                <div class="clearfix">
                    <div class="row justify-content-end">
                        <div class="col-5">
                            <table class="table table-sm">
                                <tr class="border-black o_total"><td><strong>Total (AED)</strong></td>
                                    <td class="text-end"><span t-field="o.amount_total"/></td></tr>
                            </table>
                        </div>
                    </div>
                </div>
                <p t-if="o.note" class="mt-3"><strong>Notes: </strong><span t-field="o.note"/></p>
                <p class="mt-3" t-if="o.reservation_ids.filtered(lambda r: r.state == 'active')">
                    Reserved quantities are held for you until the hold-until date shown on the reservation confirmation.
                </p>
                <p class="mt-2 text-muted">No VAT is charged on this document.</p>
                <div class="row mt-5">
                    <div class="col-6"><strong>Prepared by</strong><div class="mt-5 border-top" t-field="o.user_id"/></div>
                    <div class="col-6"><strong>Customer acceptance</strong><div class="mt-5 border-top">Name / Signature / Date</div></div>
                </div>
            </div>
        </t>
    </template>
    <template id="report_order_form">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="mariwan_reports.report_order_form_document" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>
    <record id="action_report_order_form" model="ir.actions.report">
        <field name="name">Order Form</field>
        <field name="model">mariwan.order.form</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mariwan_reports.report_order_form</field>
        <field name="print_report_name">'Order Form - %s' % object.name</field>
        <field name="binding_model_id" ref="mariwan_order_form.model_mariwan_order_form"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Task 12.3: reservation confirmation -->
    <template id="report_reservation_confirmation_document">
        <t t-call="web.external_layout">
            <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
            <t t-set="address">
                <div t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
            </t>
            <div class="page">
                <h2>Reservation Confirmation</h2>
                <div class="row mb-4">
                    <div class="col"><strong>Reference</strong><div t-field="o.name"/></div>
                    <div class="col" t-if="o.client_order_ref"><strong>Your Reference</strong><div t-field="o.client_order_ref"/></div>
                    <div class="col"><strong>Date</strong><div t-out="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d')"/></div>
                </div>
                <t t-set="active" t-value="o.reservation_ids.filtered(lambda r: r.state == 'active')"/>
                <h5>Reserved for you</h5>
                <table class="table table-sm o_main_table">
                    <thead><tr>
                        <th class="text-start">Product</th>
                        <th class="text-end">Reserved Qty</th>
                        <th class="text-start">Tentative Delivery</th>
                        <th class="text-start">Held Until</th>
                    </tr></thead>
                    <tbody>
                        <tr t-foreach="active" t-as="res">
                            <td><span t-field="res.product_id.display_name"/></td>
                            <td class="text-end"><span t-field="res.quantity"/> <span t-field="res.product_uom_id"/></td>
                            <td><span t-field="res.delivery_date"/></td>
                            <td><span t-field="res.hold_until"/></td>
                        </tr>
                        <tr t-if="not active"><td colspan="4">No quantity is reserved yet.</td></tr>
                    </tbody>
                </table>
                <t t-set="short" t-value="o.line_ids.filtered(lambda l: l.fulfilment_type != 'dropship' and l.reserved_qty &lt; l.product_qty)"/>
                <t t-if="short">
                    <h5>On order</h5>
                    <table class="table table-sm o_main_table">
                        <thead><tr>
                            <th class="text-start">Product</th>
                            <th class="text-end">Qty</th>
                            <th class="text-start">Status</th>
                        </tr></thead>
                        <tbody>
                            <tr t-foreach="short" t-as="line">
                                <td><span t-field="line.product_id.display_name"/></td>
                                <td class="text-end"><span t-out="line.product_qty - line.reserved_qty" t-options='{"widget": "float", "precision": 2}'/></td>
                                <td>On order - expected
                                    <span t-out="line.delivery_date or line.incoming_date" t-options='{"widget": "date"}'/></td>
                            </tr>
                        </tbody>
                    </table>
                </t>
                <p class="mt-4">For any question please contact <strong t-field="o.user_id"/>
                    <t t-if="o.user_id.email"> (<span t-field="o.user_id.email"/>)</t>
                    <t t-if="o.user_id.phone">, <span t-field="o.user_id.phone"/></t>.</p>
            </div>
        </t>
    </template>
    <template id="report_reservation_confirmation">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="mariwan_reports.report_reservation_confirmation_document" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>
    <record id="action_report_reservation_confirmation" model="ir.actions.report">
        <field name="name">Reservation Confirmation</field>
        <field name="model">mariwan.order.form</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mariwan_reports.report_reservation_confirmation</field>
        <field name="print_report_name">'Reservation - %s' % object.name</field>
        <field name="binding_model_id" ref="mariwan_order_form.model_mariwan_order_form"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
