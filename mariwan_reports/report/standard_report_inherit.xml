<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tasks 12.4 / 12.5: quotation and order confirmation (standard layout; no taxes are
         configured so Odoo shows no tax column or tax totals). -->
    <template id="report_saleorder_document_mariwan" inherit_id="sale.report_saleorder_document">
        <xpath expr="//div[@id='informations']" position="inside">
            <div t-if="doc.mariwan_order_form_id" class="col" name="mariwan_order_form">
                <strong>Order Form</strong>
                <div t-field="doc.mariwan_order_form_id.name"/>
            </div>
            <div class="col" name="mariwan_payment_type">
                <strong>Payment</strong>
                <div><span t-field="doc.mariwan_payment_type"/>
                    <t t-if="doc.state == 'sale' and doc.mariwan_amount_paid"> - advance received
                        <span t-field="doc.mariwan_amount_paid"/></t></div>
            </div>
        </xpath>
        <xpath expr="//th[@name='th_quantity']" position="after">
            <th t-if="doc.mariwan_order_form_id" name="th_mariwan_delivery" class="text-start">
                <t t-set="colspan_count" t-value="colspan_count + 1"/>
                Delivery / Reservation
            </th>
        </xpath>
        <xpath expr="//td[@name='td_product_quantity']" position="after">
            <td t-if="doc.mariwan_order_form_id" name="td_mariwan_delivery">
                <span t-field="line.mariwan_delivery_date"/>
                <t t-if="line.mariwan_reservation_status and line.mariwan_reservation_status != 'none'">
                    - <span t-field="line.mariwan_reservation_status"/></t>
            </td>
        </xpath>
    </template>

    <!-- Task 12.6: invoice - amount in words is the standard company option (enabled by this module). -->
    <template id="report_invoice_document_mariwan" inherit_id="account.report_invoice_document">
        <xpath expr="//div[@id='informations']" position="inside">
            <div class="col" t-if="o.mariwan_order_form_id" name="mariwan_order_form">
                <strong>Order Form</strong>
                <div t-field="o.mariwan_order_form_id.name"/>
            </div>
            <div class="col" t-if="o.move_type == 'out_invoice' and o.mariwan_order_form_id" name="mariwan_payment_type">
                <strong>Payment</strong>
                <div t-field="o.mariwan_order_form_id.payment_type"/>
            </div>
        </xpath>
    </template>

    <!-- Task 12.7: delivery note - prices are never shown on the standard slip. -->
    <template id="report_delivery_document_mariwan" inherit_id="stock.report_delivery_document">
        <xpath expr="//div[@name='div_origin']" position="after">
            <div t-if="o.mariwan_order_form_id" class="col col-3 mw-100 mb-2" name="div_mariwan_order_form">
                <strong>Order Form</strong>
                <div t-field="o.mariwan_order_form_id.name"/>
            </div>
        </xpath>
        <xpath expr="//div[@name='signature']" position="after">
            <div t-if="not o.signature and o.picking_type_code in ('outgoing', 'dropship')" class="row mt-5" name="mariwan_receiver">
                <div class="col-3"><strong>Received by</strong>
                    <div class="mt-4 border-top"><span t-field="o.mariwan_receiver_name"/></div></div>
                <div class="col-3"><strong>Signature</strong><div class="mt-4 border-top"/></div>
                <div class="col-3"><strong>Stamp</strong><div class="mt-4 border-top"/></div>
                <div class="col-3"><strong>Date</strong><div class="mt-4 border-top"/></div>
            </div>
            <p t-if="o.mariwan_condition_remarks" class="mt-3">
                <strong>Condition remarks: </strong><span t-field="o.mariwan_condition_remarks"/></p>
        </xpath>
    </template>

    <!-- Task 12.9: purchase order -->
    <template id="report_purchaseorder_document_mariwan" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//div[@id='informations']" position="inside">
            <div t-if="o.mariwan_order_form_id" class="col-2 bm-2">
                <strong>Order Form:</strong>
                <p t-field="o.mariwan_order_form_id.name" class="m-0"/>
            </div>
            <div t-if="o.mariwan_container_no" class="col-2 bm-2">
                <strong>Shipment:</strong>
                <p class="m-0"><span t-field="o.mariwan_container_no"/>
                    <t t-if="o.mariwan_port_of_loading"> / <span t-field="o.mariwan_port_of_loading"/></t></p>
            </div>
        </xpath>
        <xpath expr="//div[@id='total']" position="after">
            <p t-if="o.currency_id != o.company_id.currency_id" class="text-end text-muted">
                AED equivalent:
                <span t-out="o.currency_id._convert(o.amount_total, o.company_id.currency_id, o.company_id, o.date_order)"
                      t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
            </p>
            <p t-if="o.mariwan_delivery_type == 'dropship'">
                <strong>Deliver directly to the customer: </strong>
                <span t-field="o.dest_address_id" t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True}'/>
            </p>
            <div class="row mt-5">
                <div class="col-6 offset-6"><strong>Authorised signature</strong><div class="mt-5 border-top"/></div>
            </div>
        </xpath>
    </template>
</odoo>
